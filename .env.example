# ============================================================
#  MODELO de variáveis de ambiente — NUNCA colocar valores reais aqui.
#  Este repositório é PÚBLICO. Os valores reais vivem só em:
#    - Vercel → Project → Settings → Environment Variables
#    - Supabase → Edge Functions → Secrets
#    - .env.local no seu computador (ignorado pelo Git)
# ============================================================

# Supabase — Project Settings → API (estas duas são públicas por natureza)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON=COLAR_AQUI_A_CHAVE_ANON

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_COLAR_AQUI
STRIPE_WEBHOOK_SECRET=whsec_COLAR_AQUI
VITE_STRIPE_PUBLIC_KEY=pk_test_COLAR_AQUI

# Supabase Service Role (apenas backend/webhook — NUNCA expor no frontend)
SUPABASE_SERVICE_KEY=COLAR_AQUI

# WhatsApp Business API — https://developers.facebook.com
META_WHATSAPP_TOKEN=COLAR_AQUI
META_PHONE_ID=COLAR_AQUI

# TOConline
TOCONLINE_CLIENT_ID=COLAR_AQUI
TOCONLINE_CLIENT_SECRET=COLAR_AQUI
